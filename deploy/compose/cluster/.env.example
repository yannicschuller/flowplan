# Settings of the cluster example (compose.yaml). Copy to .env and replace
# every "change-me" – these are placeholders, not secrets.
APP_URL=http://localhost:8080
FLOWPLAN_PORT=8080
# FLOWPLAN_VERSION=latest

# Behind the load balancer (Caddy): trust one proxy hop for client addresses.
FLOWPLAN_TRUSTED_PROXIES=1

# First account only via <APP_URL>/register?setup=<token> (openssl rand -hex 24).
FLOWPLAN_SETUP_TOKEN=change-me-setup-token

# Recommended: encryption of objects in the bucket and of backups
# (openssl rand -base64 32). Keep a copy apart from the backups.
# FLOWPLAN_ENCRYPTION_KEY=

POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=flowplan
MINIO_ROOT_PASSWORD=change-me-minio
S3_BUCKET=flowplan
