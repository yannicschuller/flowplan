# Settings of the cluster example (compose.yaml). Copy to .env and replace
# every "change-me" – these are placeholders, not secrets.
APP_URL=http://localhost:8080
FLOWPLAN_PORT=8080
# FLOWPLAN_VERSION=latest

# Behind the load balancer (Caddy): trust one proxy hop for client addresses.
FLOWPLAN_TRUSTED_PROXIES=1

# First account only via <APP_URL>/register?setup=<token> (openssl rand -hex 24).
FLOWPLAN_SETUP_TOKEN=change-me-setup-token

# Required: the keys every instance shares – otherwise each one generates
# its own, and two-factor sign-in, stored secrets, unlocked share links and
# push break between instances.
# The encryption key (openssl rand -base64 32): stored secrets, objects in
# the bucket, backups. Keep a copy apart from the backups.
FLOWPLAN_ENCRYPTION_KEY=
# The web push key pair: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Flowplan's database role `flowplan` (owner of the database, no superuser).
POSTGRES_PASSWORD=change-me-postgres
# The image's superuser `postgres`, for administration only (not used by Flowplan).
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin
REDIS_PASSWORD=change-me-redis
MINIO_ROOT_USER=flowplan
MINIO_ROOT_PASSWORD=change-me-minio
S3_BUCKET=flowplan
