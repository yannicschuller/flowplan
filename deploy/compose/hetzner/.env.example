# Settings of the Hetzner example (README.md). Copy to .env and fill in.
# Every secret is empty here on purpose – generate your own; never commit .env.

# ---- Every server ----------------------------------------------------------

# This server's address in the private network (Hetzner Console → Networks),
# e.g. 10.0.0.2. Flowplan, Redis and PostgreSQL listen there only.
PRIVATE_IP=

# ---- App servers (compose.yaml) – the same on each, except PRIVATE_IP and
# FLOWPLAN_INSTANCE_ID --------------------------------------------------------

# A name per server, shown in Administration → Monitoring: app-1, app-2, …
FLOWPLAN_INSTANCE_ID=
# Pin the version for rolling updates (all servers the same), e.g. 0.9.9.
FLOWPLAN_VERSION=latest

APP_URL=https://flowplan.example.org
# First account only via <APP_URL>/register?setup=<token> (openssl rand -hex 24).
FLOWPLAN_SETUP_TOKEN=

# "1": cluster mode (active/active). "off": active/passive – Flowplan runs on
# one server at a time, REDIS_URL is not needed.
FLOWPLAN_CLUSTER=1

# PostgreSQL behind one stable address: the postgres server's private IP,
# HAProxy for Patroni (127.0.0.1:5000) or a managed service (add
# ?sslmode=require). postgres://flowplan:<password>@10.0.0.4:5432/flowplan
DATABASE_URL=
# Connections per instance; servers × (pool + 3) < max_connections.
FLOWPLAN_PG_POOL=20

# Redis on its server: redis://:<password>@10.0.0.3:6379/0
REDIS_URL=
# Stay ready while Redis is briefly away (otherwise the load balancer has no
# target left when Redis fails).
FLOWPLAN_READY_REQUIRE=database,objectStorage

# Hetzner Object Storage: a private bucket in the same location. Use the
# endpoint the console shows for the bucket.
S3_BUCKET=
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_PREFIX=flowplan
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The keys every instance shares – generate once, keep a copy apart from the
# backups. openssl rand -base64 32
FLOWPLAN_ENCRYPTION_KEY=
# npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# The Hetzner Load Balancer is the one proxy in front (X-Forwarded-For).
FLOWPLAN_TRUSTED_PROXIES=1

# E-mail: Hetzner blocks outgoing ports 25 and 465 for new accounts – use 587.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ---- Redis server (redis.yaml) ---------------------------------------------

# openssl rand -hex 24 – the same as in REDIS_URL of the app servers.
REDIS_PASSWORD=

# ---- PostgreSQL server (postgres.yaml) -------------------------------------

# Password of the role `flowplan` – the same as in DATABASE_URL.
POSTGRES_PASSWORD=
# The image's superuser `postgres`, for administration only.
POSTGRES_ADMIN_PASSWORD=
