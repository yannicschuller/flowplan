APP_URL=http://localhost:3000
FLOWPLAN_DATA_DIR=./data
OIDC_ISSUER=https://identity.example.com/realms/company
OIDC_CLIENT_ID=flowplan
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=flowplan-admins
SESSION_HOURS=8
# Optional: allow only members of this group to sign in
OIDC_ALLOWED_GROUP=
# Web Push (iOS/iPadOS 16.4+ requires HTTPS and installation on the Home Screen)
# Keep both keys stable; if omitted they are generated in FLOWPLAN_DATA_DIR/web-push-keys.json.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
