# Flowplan configuration. Copy to .env (Docker Compose) or .env.local
# (npm run dev) and fill in the values. Full reference:
# https://docs.flowplan.org/configuration

# --- Required ---------------------------------------------------------------

# Public address exactly as typed in the browser (scheme, host, port; no
# trailing slash). Used for sign-in redirects, cookies, passkeys and links.
APP_URL=http://localhost:3000

# --- Sign-in ----------------------------------------------------------------

# E-mail + password and passkeys work without further setup; the first
# account becomes the administrator. "false" leaves only OIDC.
FLOWPLAN_LOCAL_LOGIN=true

# Optional single sign-on with OpenID Connect (Keycloak, Authentik, Zitadel,
# Entra ID, …). Leave OIDC_ISSUER empty to use only e-mail and password.
# Redirect URI at the provider: <APP_URL>/api/auth/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=flowplan
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
# Groups can also give membership in workspaces and their groups: mapped in
# Settings → Groups & permissions (owners) or Administration → Workspaces.
# Members of this group administer the instance.
OIDC_ADMIN_GROUP=flowplan-admins
# Optional: only members of this group may sign in.
OIDC_ALLOWED_GROUP=

# Optional sign-in with an LDAP directory (OpenLDAP, Active Directory, …):
# the password form checks names without a local account against it, and
# groups are synced every hour into the same group mappings as SSO.
# SCIM 2.0 provisioning needs no variables: create a token under
# Administration → Users; the base URL is <APP_URL>/api/scim/v2.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
# {user} is the name typed on the sign-in page (escaped).
LDAP_USER_FILTER=(|(uid={user})(mail={user}))
LDAP_GROUP_ATTRIBUTE=memberOf
# CA certificate for ldaps:// or StartTLS (file path or PEM text).
LDAP_TLS_CA=
LDAP_STARTTLS=false
SESSION_HOURS=8
# "Stay signed in on this device" on the sign-in page (off by default; the
# desktop and mobile apps always ask for it): such sessions live on while
# used – in the browser, the app and through the app's widgets –,
# SESSION_IDLE_HOURS after the last request, never beyond SESSION_MAX_DAYS,
# for SSO the same as for passwords and passkeys. Without SESSION_REMEMBER
# every session (the apps' too) ends SESSION_HOURS after signing in.
# SESSION_REMEMBER=true
# SESSION_IDLE_HOURS=168
# SESSION_MAX_DAYS=30
# Optional: SSO sessions sign in again after this many hours, so group
# changes at the provider take effect (otherwise they follow through SCIM,
# the LDAP sync or the next sign-in). Not set by default.
# SESSION_GROUPS_HOURS=168

# --- Markdown export into Git (Admin → Versions and backup) -------------
# The chosen pages are exported with every backup; with a repository they
# are also pushed there. The token needs write access to the repository.
# EXPORT_GIT_URL=https://git.example.org/family/notes.git
# EXPORT_GIT_TOKEN=
# EXPORT_GIT_USERNAME=flowplan
# EXPORT_GIT_BRANCH=main
# Take over changes made in the repository before exporting:
# EXPORT_GIT_IMPORT=true
# Deprecated: prefer the Git export of spaces below. Keeps working.

# --- Git export of spaces (space settings → Git export) --------------------
# Space owners push their space into a repository of their own, daily or
# weekly; the token is stored sealed. Off by default.
# SPACE_GIT_EXPORT=true
# Only these Git servers (comma-separated); without it any public https server:
# SPACE_GIT_ALLOWED_HOSTS=git.example.org,codeberg.org
# A listed server with an internal address (e.g. Forgejo on the same host,
# reached via --add-host git.example.org:host-gateway); needs the list above:
# SPACE_GIT_ALLOW_PRIVATE=true

# --- GitHub/GitLab issue sync (settings → API & webhooks) -------------------
# github.com and gitlab.com always work. Self-hosted GitHub Enterprise or
# GitLab servers only when listed here (comma-separated host names):
# ISSUE_SYNC_ALLOWED_HOSTS=gitlab.example.org,github.example.org
# A listed server with an internal address; needs the list above:
# ISSUE_SYNC_ALLOW_PRIVATE=true

# --- Storage ----------------------------------------------------------------

# SQLite database, uploads and keys. /app/data in the Docker image.
FLOWPLAN_DATA_DIR=./data
# Optional S3-compatible storage (MinIO, Garage, AWS …): files are mirrored
# there and the database is backed up continuously with Litestream.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=flowplan
# Encryption of what leaves the server: files in the bucket, scheduled
# backups, Markdown exports and the instance backup (AES-256-GCM). 32 bytes,
# base64: openssl rand -base64 32. Keep it apart from the backups – without
# it they cannot be read. Or FLOWPLAN_ENCRYPTION_KEY_FILE=/run/secrets/…
FLOWPLAN_ENCRYPTION_KEY=
# After a key change: the earlier keys, comma-separated (reading only).
FLOWPLAN_ENCRYPTION_KEY_PREVIOUS=
# Litestream cannot encrypt its replica; optionally the provider does (SSE-C,
# https only, provider must support it), or set FLOWPLAN_LITESTREAM=off and
# use hourly encrypted backups instead.
LITESTREAM_SSE_C_KEY=

# --- Optional ---------------------------------------------------------------

# E-mail for invitations and digests of unread notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Inbound e-mail (Settings → Workspace → Inbound e-mail). Mail providers post
# to /api/inbound-mail/<token> without any setting here. For a mailbox of
# your own, Flowplan polls it over IMAP every two minutes and routes mail
# sent to <user>+<token>@INBOUND_MAIL_DOMAIN (plus addressing; the part
# before "+" is taken from INBOUND_IMAP_USER). INBOUND_IMAP_TLS=false only
# for a server on the same host or network (port 143 without TLS).
INBOUND_MAIL_DOMAIN=
INBOUND_IMAP_HOST=
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=
INBOUND_IMAP_PASSWORD=
INBOUND_IMAP_FOLDER=INBOX
INBOUND_IMAP_TLS=true

# Two-way calendar sync with Google Calendar and Microsoft Outlook / 365
# (Settings → Account → Connect calendar; per database "Calendar sync").
# Each person connects their own account; Flowplan polls changes every ten
# minutes. Register an OAuth app (web application) with the redirect URI
#   <APP_URL>/api/calendar-sync/callback/google     (Google Cloud Console,
#     Google Calendar API enabled, scope …/auth/calendar)
#   <APP_URL>/api/calendar-sync/callback/microsoft  (Entra ID app
#     registration, delegated permission Calendars.ReadWrite, offline_access)
# Leave a client ID empty to hide that provider.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MS_CALENDAR_CLIENT_ID=
MS_CALENDAR_CLIENT_SECRET=
# "common" (work and personal accounts), "organizations" or a tenant ID.
MS_CALENDAR_TENANT=common

# Web Push (iOS/iPadOS 16.4+ needs HTTPS and installation on the Home
# Screen). Keep both keys stable; if empty they are generated in
# FLOWPLAN_DATA_DIR/web-push-keys.json.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Push to the Flowplan apps for iPhone, iPad and Android goes through Expo's
# push service (exp.host), which hands it to Apple and Google; nothing to set
# up. "off" switches it off. Like Web Push, notifications only say that
# something new is in the inbox; MOBILE_PUSH_CONTENT=on sends their text.
MOBILE_PUSH=on
MOBILE_PUSH_CONTENT=off

# Speech-to-text for voice notes: an OpenAI-compatible Whisper server.
WHISPER_URL=
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_LANGUAGE=de

# --- AI (off by default; everything can also be set in Administration → KI) --
# Values here are defaults until an administrator saves the AI settings.
# FLOWPLAN_AI=on
# Local with Ollama (compose profile "ai", see compose.yaml):
# OLLAMA_URL=http://ollama:11434
# FLOWPLAN_AI_PROVIDER=ollama           # ollama | openai | anthropic | gemini
# FLOWPLAN_AI_MODEL=llama3.1
# FLOWPLAN_AI_EMBEDDING_MODEL=nomic-embed-text
# Or a provider on the internet (OpenAI-compatible servers: base URL with /v1):
# FLOWPLAN_AI_BASE_URL=https://api.openai.com/v1
# The key is never stored in the database and only used for exactly the
# provider and address above. Or FLOWPLAN_AI_API_KEY_FILE=/run/secrets/…
# FLOWPLAN_AI_API_KEY=
# FLOWPLAN_AI_ACCESS=everyone           # everyone | selected
# FLOWPLAN_AI_GUESTS=off
# FLOWPLAN_AI_USER_PROVIDERS=off        # people may add their own provider and key
# FLOWPLAN_AI_FEATURES=write,summarize,ask,database
# FLOWPLAN_AI_REQUESTS_PER_HOUR=300     # per person
# API keys entered in the interface are stored encrypted (AES-256-GCM) with a
# key derived from FLOWPLAN_ENCRYPTION_KEY, else FLOWPLAN_SECRETS_KEY (32
# bytes, base64; or FLOWPLAN_SECRETS_KEY_FILE), else secrets.key generated in
# FLOWPLAN_DATA_DIR. secrets.key is not in the instance backup – after a
# restore on another server, enter the API keys again.
# FLOWPLAN_SECRETS_KEY=

# Default storage quota per workspace in MB (0 = unlimited).
FLOWPLAN_WORKSPACE_QUOTA_MB=
# Number of reverse proxies in front of Flowplan (for the client address;
# 0 = trust no header). Without X-Forwarded-For only per-account and per-link
# limits apply.
FLOWPLAN_TRUSTED_PROXIES=1
# MB that visitors without an account may upload per day on the whole
# instance (anonymous forms, editing links; 0 = unlimited). Each form or link
# additionally gets 200 MB per day.
FLOWPLAN_ANONYMOUS_UPLOAD_MB=1024
# At least 16 characters: enables /api/metrics (Prometheus format). Sent as
# "Authorization: Bearer …" it also unlocks the details of /api/health
# (checks, backlogs, object storage, uptime); without it the health check
# answers only {"service":"flowplan","status":"ok"} (or 503 with "error").
FLOWPLAN_METRICS_TOKEN=
# true: /api/openapi.json and /api/docs readable without signing in (visitors
# see only the major version). Default: only signed-in people and API tokens.
# FLOWPLAN_PUBLIC_API_DOCS=true
# off: no usage statistics for Administration → Überwachung (requests per
# minute, active people per hour, AI tokens, storage per day – counts only,
# no addresses or names). Default: on; an administrator can switch it off too.
# FLOWPLAN_METRICS=off

# Legal notice and privacy policy of the operator: shown on the sign-in page,
# under shared pages and forms and in the account menu – only when set.
IMPRINT_URL=
PRIVACY_URL=
