{
  "name": "flowplan-desktop",
  "productName": "Flowplan",
  "version": "1.0.0",
  "description": "Flowplan als Desktop-App für macOS, Windows und Linux",
  "main": "main.js",
  "private": true,
  "author": "Flowplan",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:dir": "electron-builder --dir",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.flowplan.desktop",
    "productName": "Flowplan",
    "copyright": "Flowplan",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "pages/**",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "artifactName": "Flowplan-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Flowplan"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Flowplan-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Flowplan",
      "artifactName": "Flowplan-${version}-windows-${arch}-setup.${ext}"
    },
    "linux": {
      "category": "Office",
      "executableName": "flowplan",
      "synopsis": "Dokumente, Datenbanken, Whiteboards und ein Journal",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Flowplan-${version}-linux-${arch}.${ext}"
    }
  },
  "homepage": "https://flowplan.org"
}
